<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Nestline Speedway collects nothing. Gameplay is offline: no ads, no
	analytics, no attribution, no crash reporting, no accounts. The only
	network use is Settings opening the hosted Privacy Policy and Support
	pages. Save data stays on device via shared_preferences.
	See https://nestlinnespeedway.com/privacy-policy.html
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
